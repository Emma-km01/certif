generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  priority    Priority
  status      Status   @default(TODO)
  due_date    DateTime
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("tasks")
}